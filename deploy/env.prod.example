# Miru-Ecommerce · variables de los servicios del VPS
# Copiar a deploy/.env.prod (NO commitear) y completar. Este archivo es la
# plantilla: no contiene secretos reales.

# --- Supabase Cloud (producción) ---
SUPABASE_URL=https://zgvfaqhahutkarbbwagi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Webhooks ---
# Secreto compartido con la plataforma de origen (por canal si se separa).
MIRU_WEBHOOK_HMAC_SECRET=replace-with-hmac-secret
MIRU_WEBHOOK_QUEUE=miru-webhooks

# --- Ingesta ---
PORT=3001
HOST=0.0.0.0

# --- Servidor MCP (solo lectura) ---
MCP_API_TOKEN=replace-with-long-random-token
MCP_TENANT_ID=00000000-0000-0000-0000-000000000000

# REDIS_URL lo fija docker-compose (redis://redis:6379).

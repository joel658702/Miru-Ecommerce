# Miru-Ecommerce · variables de entorno para desarrollo local
# Copiar a .env y reemplazar los placeholders. NUNCA commitear valores reales.

# --- Supabase local (Supabase CLI / Docker) ---
# Públicas: las únicas que pueden llegar al cliente.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# --- Solo servidor (ingest / API) ---
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
MIRU_WEBHOOK_HMAC_SECRET=replace-with-hmac-secret

# --- Redis local (docker compose) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Puertos locales ---
PORT=3001
HOST=0.0.0.0
